prune packaging/arch/src
prune packaging/arch/pkg
include scripts/linux-build.sh scripts/linux-install.sh scripts/linux-desktop.py scripts/arch-package.sh
include scripts/linux-compare.py
include install.sh scripts/linux-check.py scripts/linux-demo.py
