include LICENSE
include README.md SECURITY.md THIRD_PARTY_NOTICES.md
recursive-include docs/screenshots *.png
recursive-include docs/media *.mp4 *.gif
recursive-include docs/examples *.json *.png
include linux/README.md
recursive-include Compositor/Rendering *.c *.h

recursive-include linux/tests *.py
